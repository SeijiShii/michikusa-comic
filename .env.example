# === 道草コミック 環境変数テンプレート ===
# 実値は .env.development.local (dev/test) / .env.production.local (本番 live) に。.env.local には live を書かない (CF-013)
# 取得手順は docs/PREREQUISITES.md §1-§9 参照

# --- DB (Neon Postgres) ---
DATABASE_URL=postgresql://...          # neon.tech → プロジェクト/branch の接続文字列

# --- 認証 (Clerk) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...  # clerk.com → API keys (Publishable)
CLERK_SECRET_KEY=sk_test_...            # clerk.com → API keys (Secret)
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_... # (任意) Clerk Webhooks 登録後
GUEST_TOKEN_SECRET=                     # 自前署名 guest JWT の HMAC 秘密鍵 (32B+ ランダム、サーバ専用・ブラウザ非露出、owner churn 根絶 revise_001)

# --- 外部 AI ---
OPENAI_API_KEY=sk-...                  # platform.openai.com (Vision、写真理解)
GEMINI_API_KEY=...                     # aistudio.google.com (4 コマ画像生成)

# --- ストレージ (Cloudflare R2) ---
R2_ACCOUNT_ID=...                      # dash.cloudflare.com → R2
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=michikusa-photos

# --- 決済 (Stripe, PWYW) ---
STRIPE_SECRET_KEY=sk_test_...          # dashboard.stripe.com → API keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...        # Webhooks 登録後 (URL は §3.2 ドメイン確定後)

# --- 監視/計測 ---
SENTRY_DSN=https://...                 # sentry.io
# VITE_VERCEL_ANALYTICS=1              # Vercel Web Analytics (cookieless, 自動)

# --- レート制限 (SEC-003, 任意) ---
# UPSTASH_REDIS_REST_URL=...
# UPSTASH_REDIS_REST_TOKEN=...

# --- コスト単価 (§4.6.2, ハードコード禁止) ---
COST_GEMINI_IMAGE_PER_GEN=0.02         # 要確認 (USD/生成)
COST_OPENAI_GPT4O_MINI_PER_1K_INPUT=0.00015
COST_OPENAI_GPT4O_MINI_PER_1K_OUTPUT=0.0006
COST_R2_STORAGE_PER_GB_PER_MONTH=0.015

# --- アプリ設定 ---
APP_BASE_URL=http://localhost:5173     # 本番は https://<subdomain>
